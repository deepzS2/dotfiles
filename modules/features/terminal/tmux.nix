{
  self,
  inputs,
  ...
}: let
  inherit (self) directories;
in {
  flake.modules.hjem.tmux = {
    pkgs,
    lib,
    ...
  }: let
    plugins = [pkgs.tmuxPlugins.vim-tmux-navigator];
  in {
    config = {
      packages = [
        pkgs.tmux
        pkgs.smug
        inputs.workmux.packages.${pkgs.stdenv.hostPlatform.system}.default
      ];

      xdg.config.files."tmux/tmux.conf".source = "${directories.config}/tmux/tmux.conf";
      xdg.config.files."tmux/plugins.conf".text = ''
        # Autogenerated plugins configuration
        ${(lib.concatMapStringsSep "\n\n" (plugin: ''
            # ${plugin.pname}
            run-shell ${plugin.rtp}
          '')
          plugins)}
      '';
      xdg.config.files."tmux/theme.sh" = {
        source = "${directories.config}/tmux/theme.sh";
        executable = true;
      };
      xdg.config.files."tmux/sessionizer.sh" = {
        source = "${directories.config}/tmux/sessionizer.sh";
        executable = true;
      };
      xdg.config.files."tmux/workmux-fzf.sh" = {
        source = "${directories.config}/tmux/workmux-fzf.sh";
        executable = true;
      };
      xdg.config.files."tmux/workmux-add.sh" = {
        source = "${directories.config}/tmux/workmux-add.sh";
        executable = true;
      };

      xdg.config.files."workmux/config.yaml".source = "${directories.config}/tmux/workmux.yaml";
    };
  };
}
