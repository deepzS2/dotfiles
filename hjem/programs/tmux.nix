{
  lib,
  pkgs,
  self,
  inputs,
  ...
}: let
  plugins = [pkgs.tmuxPlugins.vim-tmux-navigator];
in {
  packages = [
    pkgs.tmux
    pkgs.smug
    inputs.workmux.packages.${pkgs.stdenv.hostPlatform.system}.default
  ];

  xdg.config.files = {
    "tmux/tmux.conf".source = "${self}/config/tmux/tmux.conf";
    "tmux/plugins.conf".text = ''
      # Autogenerated plugins configuration
      ${(lib.concatMapStringsSep "\n\n" (plugin: ''
          # ${plugin.pname}
          run-shell ${plugin.rtp}
        '')
        plugins)}
    '';
    "tmux/theme.sh" = {
      source = "${self}/config/tmux/theme.sh";
      executable = true;
    };
    "tmux/sessionizer.sh" = {
      source = "${self}/config/tmux/sessionizer.sh";
      executable = true;
    };
    "tmux/workmux-fzf.sh" = {
      source = "${self}/config/tmux/workmux-fzf.sh";
      executable = true;
    };
    "tmux/workmux-add.sh" = {
      source = "${self}/config/tmux/workmux-add.sh";
      executable = true;
    };

    "workmux/config.yaml".source = "${self}/config/tmux/workmux.yaml";
  };
}
