{
  lib,
  pkgs,
  self,
  inputs,
  ...
}: let
  plugins = [pkgs.tmuxPlugins.vim-tmux-navigator pkgs.tmuxPlugins.tmux-thumbs];
in {
  packages = [
    inputs.workmux.packages.${pkgs.stdenv.hostPlatform.system}.default
    self.packages.${pkgs.stdenv.hostPlatform.system}.tmux-sessionizer
    pkgs.tmux
    pkgs.smug
  ];

  xdg.config.files = {
    "tmux/tmux.conf".source = "${self}/config/tmux/tmux.conf";
    "tmux/theme.conf".source = "${self}/config/tmux/theme.conf";
    "workmux/config.yaml".source = "${self}/config/tmux/workmux.yaml";

    "tmux/plugins.conf".text = ''
      # Autogenerated plugins configuration
      ${(lib.concatMapStringsSep "\n\n" (plugin: ''
          # ${plugin.pname}
          run-shell ${plugin.rtp}
        '')
        plugins)}
    '';
  };
}
